# CodeGuard AI Configuration Example

# API Server Settings
PORT=8000
HOST=127.0.0.1
PROJECT_NAME="CodeGuard AI"

# Persistence & Storage
DATABASE_URL=sqlite:///./codeguard.db
STORAGE_DIR=./storage
ALLOW_SOURCE_PERSISTENCE=true

# Upload Limits
MAX_UPLOAD_SIZE_BYTES=15728640
MAX_UPLOAD_FILES=150

# Analyzer Configuration
RADON_CC_WARN=10
RADON_CC_HIGH=20
RADON_MI_WARN=20.0
SEMGREP_ENABLED=false
ANALYZER_TIMEOUT_SECONDS=25

# Optional Local AI Integration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=codellama
OLLAMA_TIMEOUT_SECONDS=30
